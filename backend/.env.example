# Application
APP_NAME=StockPilot
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000

# Market data (get free keys from each provider's dashboard)
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=

# News
NEWS_API_KEY=

# Economic data
FRED_API_KEY=

# Optional: LLM for report synthesis (future milestone)
OPENAI_API_KEY=

# Clerk JWT verification (optional — not used with current custom auth)
CLERK_JWKS_URL=

# Redis cache (optional, future)
REDIS_URL=redis://localhost:6379
