# Session signing secret (generate a random string for production)
AUTH_SECRET=change-me-to-a-long-random-string

# PostgreSQL (use when Docker is running: docker compose up -d)
# DATABASE_URL=postgresql://stockpilot:stockpilot_dev@localhost:5432/stockpilot

# SQLite — relative to prisma/schema.prisma (resolves to prisma/dev.db)
DATABASE_URL="file:./dev.db"

# FastAPI backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# App URL (required for OAuth redirect callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: direct keys only if proxying through Next.js API routes
# Never expose these as NEXT_PUBLIC_*
