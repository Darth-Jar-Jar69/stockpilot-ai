# Session signing secret (generate a random string for production)
AUTH_SECRET=change-me-to-a-long-random-string

# PostgreSQL (local Docker: docker compose up -d, or Neon)
DATABASE_URL=postgresql://stockpilot:stockpilot_dev@localhost:5432/stockpilot
# Optional: Neon non-pooler URL (required when using Neon pooler for DATABASE_URL)
DATABASE_URL_DIRECT=postgresql://stockpilot:stockpilot_dev@localhost:5432/stockpilot

# FastAPI backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# App URL (required for OAuth redirect callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email verification (Resend — https://resend.com)
# Free testing sender: StockPilot <onboarding@resend.dev>
RESEND_API_KEY=
EMAIL_FROM=StockPilot <onboarding@resend.dev>

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: direct keys only if proxying through Next.js API routes
# Never expose these as NEXT_PUBLIC_*
